+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn synthetic_italic_is_used_only_for_upright_fallback_faces() {
+        assert!(should_synthesize_italic(usvg::FontStyle::Italic, false));
+        assert!(should_synthesize_italic(usvg::FontStyle::Oblique, false));
+        assert!(!should_synthesize_italic(usvg::FontStyle::Normal, false));
+        assert!(!should_synthesize_italic(usvg::FontStyle::Italic, true));
+    }
+
+    #[test]
+    fn synthetic_italic_shears_without_changing_advance_scale() {
+        let transform = synthetic_italic_transform();
+        assert_eq!(transform.sx, 1.0);
+        assert_eq!(transform.sy, 1.0);
+        assert_eq!(transform.ky, 0.0);
+        assert!(transform.kx > 0.2 && transform.kx < 0.25);
+        assert_eq!(transform.tx, 0.0);
+        assert_eq!(transform.ty, 0.0);
+    }
+}
