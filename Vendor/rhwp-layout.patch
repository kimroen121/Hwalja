+    pub fn line_place_native(&self, section_idx: usize, para_idx: usize, line: usize) -> Option<(u32, u16, u32)> {
+        use crate::renderer::pagination::PageItem;
+        let base: usize = self.pagination.iter().take(section_idx).map(|pr| pr.pages.len()).sum();
