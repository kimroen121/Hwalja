+    /// One mirror of `flip`: 0 across the rows, 1 across the columns, 2 over the diagonal.
+    fn flip_step(&mut self, step: u8, margins: bool, turned_fill: &mut dyn FnMut(u16, [usize; 4]) -> u16) {
+        // Sides are left, right, top, bottom.
+        let sides = match step {
+            0 => [0, 1, 3, 2],
+            1 => [1, 0, 2, 3],
+            _ => [2, 3, 0, 1],
+        };
+        let turn_padding = |p: &mut crate::model::Padding| {
+            let old = [p.left, p.right, p.top, p.bottom];
+            [p.left, p.right, p.top, p.bottom] = sides.map(|i| old[i]);
+        };
+        let (rows, cols) = (self.row_count, self.col_count);
+        for cell in &mut self.cells {
+            match step {
+                0 => cell.row = rows - cell.row - cell.row_span.max(1),
+                1 => cell.col = cols - cell.col - cell.col_span.max(1),
+                _ => {
+                    (cell.row, cell.col) = (cell.col, cell.row);
+                    (cell.row_span, cell.col_span) = (cell.col_span, cell.row_span);
+                }
+            }
+            if margins {
+                turn_padding(&mut cell.padding);
+            }
+            cell.border_fill_id = turned_fill(cell.border_fill_id, sides);
+        }
+        for zone in &mut self.zones {
+            match step {
+                0 => (zone.start_row, zone.end_row) = (rows - 1 - zone.end_row.min(rows - 1), rows - 1 - zone.start_row.min(rows - 1)),
+                1 => (zone.start_col, zone.end_col) = (cols - 1 - zone.end_col.min(cols - 1), cols - 1 - zone.start_col.min(cols - 1)),
+                _ => {
+                    (zone.start_row, zone.start_col) = (zone.start_col, zone.start_row);
+                    (zone.end_row, zone.end_col) = (zone.end_col, zone.end_row);
+                }
+            }
+            zone.border_fill_id = turned_fill(zone.border_fill_id, sides);
+        }
+        self.border_fill_id = turned_fill(self.border_fill_id, sides);
+        if margins {
+            turn_padding(&mut self.padding);
+        }
+        if step == 2 {
+            (self.row_count, self.col_count) = (cols, rows);
+        }
+    }
