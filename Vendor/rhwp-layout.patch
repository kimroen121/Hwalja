+pub(crate) fn stretched_width(delimiter: &str, height: f64, fs: f64) -> Option<f64> {
+    let mut chars = delimiter.chars();
+    let (Some(c), None) = (chars.next(), chars.next()) else {
+        return None;
+    };
+    let scale = fs / super::stix::units_per_em();
+    Some(super::stix::stretched(c, true, height / scale)?.width() * scale)
