+/// hwalja: REL's arrow across its box, so it spans what is written over and under it:
+/// the font's, or lines without it. Returns false for other symbols.
+fn draw_rel_arrow(svg: &mut String, arrow: &str, x: f64, y: f64, w: f64, h: f64, color: &str) -> bool {
+    // The font's arrow, grown to the width, on the glyph's baseline (0.8 em down the box).
+    let scale = h / super::stix::units_per_em();
+    let mut chars = arrow.chars();
+    if let (Some(c), None) = (chars.next(), chars.next()) {
+        if let Some(shape) = super::stix::stretched(c, false, w / scale) {
+            svg.push_str(&shape.path(
+                x + (w - shape.width() * scale) / 2.0,
+                y + h * 0.8 - shape.y_max * scale,
+                scale,
+                color,
+            ));
+            return true;
+        }
+    }
+    let (left, right, double) = match arrow {
+        "→" => (false, true, false),
+        "←" => (true, false, false),
+        "↔" => (true, true, false),
+        "⇒" => (false, true, true),
+        "⇐" => (true, false, true),
+        "⇔" => (true, true, true),
+        _ => return false,
+    };
+    // The glyph's axis sits a quarter em above its baseline (0.8 em down the box).
+    let (mid, stroke, head) = (y + h * 0.55, h * 0.045, h * 0.22);
+    let gap = if double { h * 0.09 } else { 0.0 };
+    let mut d = String::new();
+    let inset = |end: bool| if end && double { head * 0.5 } else { 0.0 };
+    for dy in if double { vec![-gap, gap] } else { vec![0.0] } {
+        d.push_str(&format!("M{:.2},{:.2} H{:.2} ", x + inset(left), mid + dy, x + w - inset(right)));
+    }
+    if left {
+        d.push_str(&format!("M{:.2},{:.2} L{:.2},{:.2} L{:.2},{:.2} ", x + head, mid - head * 0.8, x, mid, x + head, mid + head * 0.8));
+    }
+    if right {
+        let r = x + w;
+        d.push_str(&format!("M{:.2},{:.2} L{:.2},{:.2} L{:.2},{:.2} ", r - head, mid - head * 0.8, r, mid, r - head, mid + head * 0.8));
+    }
+    svg.push_str(&format!(
+        "<path d=\"{}\" fill=\"none\" stroke=\"{}\" stroke-width=\"{:.2}\" stroke-linecap=\"round\"/>\n",
+        d.trim_end(), color, stroke,
+    ));
+    true
+}
