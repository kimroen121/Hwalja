+/// usvg's font database types, for backends that must pick the faces PDF export picks.
+#[cfg(not(target_arch = "wasm32"))]
+pub use usvg::fontdb;
+
+/// The font database PDF export uses with default options.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn default_fontdb() -> std::sync::Arc<usvg::fontdb::Database> {
+    cached_fontdb(&PdfExportOptions::default()).0
+}
+
+/// Font picks per font specification, valid for one database.
+#[cfg(not(target_arch = "wasm32"))]
+type FontPicks = std::sync::Arc<
+    std::sync::Mutex<std::collections::HashMap<usvg::Font, Option<usvg::fontdb::ID>>>,
+>;
+
+/// Font database built once per option set and shared by every export, with each font
+/// file mapped once, plus the fonts already picked from it: picking scans every face,
+/// and a page asks for the same few fonts once per character.
+#[cfg(not(target_arch = "wasm32"))]
+fn cached_fontdb(options: &PdfExportOptions) -> (std::sync::Arc<usvg::fontdb::Database>, FontPicks) {
+    use std::sync::{Arc, Mutex};
+    type Key = (String, String, String, Option<String>, Vec<std::path::PathBuf>);
+    static CACHE: Mutex<Option<(Key, Arc<usvg::fontdb::Database>, FontPicks)>> = Mutex::new(None);
+    let key: Key = (
+        options.fallback_serif.clone(),
+        options.fallback_sans.clone(),
+        options.fallback_mono.clone(),
+        options.equation_font.clone(),
+        options.font_paths.clone(),
+    );
+    let mut cache = CACHE.lock().unwrap_or_else(|e| e.into_inner());
+    match &*cache {
+        Some((cached, db, picks)) if *cached == key => (db.clone(), picks.clone()),
+        _ => {
+            let mut db = create_fontdb(options);
+            // Map each font file once instead of reopening it for every glyph lookup.
