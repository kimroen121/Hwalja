+pub(crate) fn integral_width(fs: f64, symbol: &str) -> f64 {
+    if let Some(shape) = integral_glyph(symbol) {
+        let g = integral_geom(fs);
+        return shape.width() * (g.bottom_y - g.top_y) / shape.height();
+    }
+    let (strokes, _) = integral_strokes(symbol);
+    integral_geom(fs).width + (strokes - 1) as f64 * fs * INTEGRAL_STROKE_STEP
