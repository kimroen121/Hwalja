+    pub(crate) fn missing_cell_picture_prefix_overlap(
+        &self,
+        para: &Paragraph,
+        text_height: f64,
+    ) -> f64 {
+        if !para.line_segs.is_empty() || para.text.trim().is_empty() || para.controls.is_empty() {
+            return 0.0;
+        }
+        let mut earliest_top = f64::INFINITY;
+        let mut latest_top = 0.0_f64;
+        let mut earliest_bottom = f64::INFINITY;
+        for control in &para.controls {
+            let Control::Picture(pic) = control else { return 0.0; };
+            let c = &pic.common;
+            if !c.treat_as_char
+                && c.flow_with_text
+                && matches!(c.text_wrap, TextWrap::TopAndBottom)
+                && matches!(c.vert_rel_to, VertRelTo::Para)
+                && matches!(c.vert_align, crate::model::shape::VertAlign::Top)
+            {
+                let top = hwpunit_to_px((c.vertical_offset as i32).max(0), self.dpi);
+                earliest_top = earliest_top.min(top);
+                latest_top = latest_top.max(top);
+                earliest_bottom = earliest_bottom.min(top + hwpunit_to_px(c.height as i32, self.dpi));
+            } else {
+                return 0.0;
+            }
         }
+        // Side-by-side pictures share one exclusion band and one text prefix.
+        // Separate vertical bands remain on the existing layout path.
+        if latest_top < earliest_bottom {
+            earliest_top.min(text_height.max(0.0))
+        } else {
+            0.0
+        }
