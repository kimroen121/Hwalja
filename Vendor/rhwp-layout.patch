+    /// 모양을 모두 `to` 글꼴로 바꾼다. 바꾼 글자 모양이 없으면 false.
+    pub fn replace_font_native(&mut self, lang: Option<usize>, from: &str, to: &str) -> bool {
+        let langs: Vec<usize> = match lang {
+            Some(l) if l < 7 => vec![l],
+            Some(_) => return false,
+            None => (0..7).collect(),
+        };
+        let mut changed = false;
+        for l in langs {
+            let uses = |doc: &crate::model::document::Document, id: u16| {
+                doc.doc_info.font_faces.get(l).and_then(|f| f.get(id as usize)).is_some_and(|f| f.name == from)
+            };
+            if !self.document.doc_info.char_shapes.iter().any(|c| uses(&self.document, c.font_ids[l])) {
+                continue;
+            }
+            let to_id = self.find_or_create_font_id_for_lang(l, to);
+            if to_id < 0 {
+                continue;
+            }
+            let ids: Vec<bool> =
+                self.document.doc_info.char_shapes.iter().map(|c| uses(&self.document, c.font_ids[l])).collect();
+            for (shape, hit) in self.document.doc_info.char_shapes.iter_mut().zip(ids) {
+                if hit {
+                    shape.font_ids[l] = to_id as u16;
+                    shape.raw_data = None;
+                    changed = true;
+                }
+            }
+        }
+        if changed {
+            self.document.doc_info.raw_stream_dirty = true;
+            self.rebuild_resolved_styles();
+            self.recompose_and_paginate();
+        }
+        changed
+    }
