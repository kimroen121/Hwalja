+/// HwpStudio: grows a reflowed line for an object in it. An equation stands on its own
+/// baseline (`baseline` percent of its height down), so the line takes the larger of the
+/// text's and the equation's parts above and below the baseline; other objects keep
+/// [`apply_inline_control_line_height`].
+fn apply_inline_control_line_metrics(seg: &mut LineSeg, height_hwp: i32, baseline_hwp: Option<i32>) {
+    let Some(above) = baseline_hwp.filter(|above| (0..=height_hwp).contains(above)) else {
+        return apply_inline_control_line_height(seg, height_hwp);
+    };
+    let ascent = seg.baseline_distance.max(above);
+    let descent = (seg.line_height - seg.baseline_distance).max(height_hwp - above);
+    seg.line_height = ascent + descent;
+    seg.text_height = ascent + descent;
+    seg.baseline_distance = ascent;
+}
+
+/// HwpStudio: each object in the line of a paragraph with its height and, for an equation,
+/// its baseline from the top.
+fn inline_control_metrics_hwp(para: &Paragraph) -> Vec<(i32, Option<i32>)> {
+    para.controls
+        .iter()
+        .filter_map(|control| {
+            let (_, height) = inline_control_size_hwp(control)?;
+            let baseline = match control {
+                Control::Equation(equation) if equation.baseline > 0 => {
+                    Some(height.saturating_mul(i32::from(equation.baseline)) / 100)
+                }
+                _ => None,
+            };
+            Some((height, baseline))
+        })
+        .collect()
+}
