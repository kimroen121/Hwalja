+pub(crate) fn note_number_text(number: u16, code: u32) -> String {
+    const JAMO: [char; 14] = [
+        'ㄱ', 'ㄴ', 'ㄷ', 'ㄹ', 'ㅁ', 'ㅂ', 'ㅅ', 'ㅇ', 'ㅈ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ',
+    ];
+    const GAPEUL: [char; 10] = ['갑', '을', '병', '정', '무', '기', '경', '신', '임', '계'];
+    const GAPEUL_HANJA: [char; 10] = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
+    const SYMBOLS: [char; 4] = ['*', '†', '‡', '§'];
+    let n = number.max(1) as usize;
+    let from = |first: u32, count: usize| {
+        (n <= count)
+            .then(|| char::from_u32(first + n as u32 - 1))
+            .flatten()
+            .map(String::from)
+    };
+    let cycle = |chars: &[char]| chars[(n - 1) % chars.len()].to_string();
+    let text = match code {
+        6 => from(0x24B6, 26),
+        7 => from(0x24D0, 26),
+        9 => from(0x326E, 14),
+        10 => Some(cycle(&JAMO)),
+        11 => from(0x3260, 14),
+        14 => from(0x3280, 10),
+        15 => Some(cycle(&GAPEUL)),
+        16 => Some(cycle(&GAPEUL_HANJA)),
+        0x80 => Some(SYMBOLS[(n - 1) % 4].to_string().repeat((n - 1) / 4 + 1)),
+        _ => None,
+    };
+    text.unwrap_or_else(|| format_number(number, note_number_format_from_hwp_code(code as u8)))
 }
 
