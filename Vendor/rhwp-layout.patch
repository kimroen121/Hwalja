diff --git a/src/renderer/equation/stix.rs b/src/renderer/equation/stix.rs
--- a/src/renderer/equation/stix.rs
+++ b/src/renderer/equation/stix.rs
@@ -0,0 +1,210 @@
+//! hwalja: 수식 기호(적분·근호·괄호·화살표·장식)를 STIX Two Math 글리프로 그린다.
+//! 기호를 늘릴 때는 글꼴 MATH 표의 크기 변형 글리프를 고르고, 그보다 길면 표의 조각
+//! 이음(assembly)으로 잇는다. 글꼴이 없으면 모두 `None` 이고 호출부는 종전대로 그린다.
+
+use std::sync::OnceLock;
+use ttf_parser::{Face, GlyphId};
+
+/// The installed STIX Two Math.
+fn face() -> Option<&'static Face<'static>> {
+    static FACE: OnceLock<Option<Face<'static>>> = OnceLock::new();
+    FACE.get_or_init(|| {
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            let db = crate::renderer::pdf::default_fontdb();
+            let query = usvg::fontdb::Query {
+                families: &[usvg::fontdb::Family::Name("STIX Two Math")],
+                ..Default::default()
+            };
+            let id = db.query(&query)?;
+            let (data, index) = db.with_face_data(id, |data, index| (data.to_vec(), index))?;
+            Face::parse(Box::leak(data.into_boxed_slice()), index).ok()
+        }
+        #[cfg(target_arch = "wasm32")]
+        None
+    })
+    .as_ref()
+}
+
+/// Glyphs placed in font units (y up), and the ink box around them.
+pub(crate) struct Shape {
+    glyphs: Vec<(GlyphId, f64, f64)>,
+    pub x_min: f64,
+    pub x_max: f64,
+    pub y_min: f64,
+    pub y_max: f64,
+}
+
+impl Shape {
+    fn new() -> Self {
+        Shape {
+            glyphs: Vec::new(),
+            x_min: f64::INFINITY,
+            x_max: f64::NEG_INFINITY,
+            y_min: f64::INFINITY,
+            y_max: f64::NEG_INFINITY,
+        }
+    }
+    fn add(&mut self, face: &Face, glyph: GlyphId, dx: f64, dy: f64) {
+        if let Some(r) = face.glyph_bounding_box(glyph) {
+            self.x_min = self.x_min.min(dx + r.x_min as f64);
+            self.x_max = self.x_max.max(dx + r.x_max as f64);
+            self.y_min = self.y_min.min(dy + r.y_min as f64);
+            self.y_max = self.y_max.max(dy + r.y_max as f64);
+        }
+        self.glyphs.push((glyph, dx, dy));
+    }
+    pub fn width(&self) -> f64 {
+        self.x_max - self.x_min
+    }
+    pub fn height(&self) -> f64 {
+        self.y_max - self.y_min
+    }
+
+    /// A filled SVG path of the shape, its ink's top-left at (`left`, `top`), `scale` px a unit.
+    pub fn path(&self, left: f64, top: f64, scale: f64, color: &str) -> String {
+        struct Builder<'a> {
+            d: &'a mut String,
+            at: &'a dyn Fn(f32, f32) -> (f64, f64),
+        }
+        impl Builder<'_> {
+            fn point(&mut self, command: char, points: &[(f32, f32)]) {
+                self.d.push(command);
+                for &(x, y) in points {
+                    let (x, y) = (self.at)(x, y);
+                    self.d.push_str(&format!("{x:.2},{y:.2} "));
+                }
+            }
+        }
+        impl ttf_parser::OutlineBuilder for Builder<'_> {
+            fn move_to(&mut self, x: f32, y: f32) {
+                self.point('M', &[(x, y)]);
+            }
+            fn line_to(&mut self, x: f32, y: f32) {
+                self.point('L', &[(x, y)]);
+            }
+            fn quad_to(&mut self, x1: f32, y1: f32, x: f32, y: f32) {
+                self.point('Q', &[(x1, y1), (x, y)]);
+            }
+            fn curve_to(&mut self, x1: f32, y1: f32, x2: f32, y2: f32, x: f32, y: f32) {
+                self.point('C', &[(x1, y1), (x2, y2), (x, y)]);
+            }
+            fn close(&mut self) {
+                self.d.push('Z');
+            }
+        }
+        let Some(face) = face() else {
+            return String::new();
+        };
+        let mut d = String::new();
+        for &(glyph, dx, dy) in &self.glyphs {
+            let at = |x: f32, y: f32| {
+                (
+                    left + (dx + x as f64 - self.x_min) * scale,
+                    top + (self.y_max - dy - y as f64) * scale,
+                )
+            };
+            face.outline_glyph(glyph, &mut Builder { d: &mut d, at: &at });
+        }
+        format!("<path d=\"{}\" fill=\"{}\"/>\n", d.trim_end(), color)
+    }
+}
+
+/// Font units in an em.
+pub(crate) fn units_per_em() -> f64 {
+    face().map_or(1000.0, |f| f.units_per_em() as f64)
+}
+
+/// The thickness of the rule a radical draws over its body, in font units.
+pub(crate) fn radical_rule() -> Option<f64> {
+    let constants = face()?.tables().math?.constants?;
+    Some(constants.radical_rule_thickness().value as f64)
+}
+
+/// The glyph named `name` (a variant with no character of its own, such as `uni222B.updsp`).
+pub(crate) fn named(name: &str) -> Option<Shape> {
+    let face = face()?;
+    let mut shape = Shape::new();
+    shape.add(face, face.glyph_index_by_name(name)?, 0.0, 0.0);
+    Some(shape)
+}
+
+/// `c` grown along one axis to at least `length` font units: the first size variant that
+/// reaches it, or the glyph assembled from its parts, or failing both its largest variant.
+pub(crate) fn stretched(c: char, vertical: bool, length: f64) -> Option<Shape> {
+    let face = face()?;
+    let base = face.glyph_index(c)?;
+    let variants = face.tables().math.and_then(|m| m.variants);
+    let construction = variants.and_then(|v| {
+        if vertical {
+            v.vertical_constructions.get(base)
+        } else {
+            v.horizontal_constructions.get(base)
+        }
+    });
+    let mut chosen = base;
+    if let Some(construction) = construction {
+        for variant in construction.variants {
+            chosen = variant.variant_glyph;
+            if variant.advance_measurement as f64 >= length {
+                let mut shape = Shape::new();
+                shape.add(face, chosen, 0.0, 0.0);
+                return Some(shape);
+            }
+        }
+        if let (Some(assembly), Some(v)) = (construction.assembly, variants) {
+            return assembled(face, assembly, v.min_connector_overlap as f64, vertical, length);
+        }
+    }
+    let mut shape = Shape::new();
+    shape.add(face, chosen, 0.0, 0.0);
+    Some(shape)
+}
+
+/// The assembly's parts in order (bottom to top, or left to right), its extenders repeated
+/// until it spans `length`, the overlaps then widened (as far as the connectors allow) so
+/// it spans no more.
+fn assembled(
+    face: &Face,
+    assembly: ttf_parser::math::GlyphAssembly,
+    min_overlap: f64,
+    vertical: bool,
+    length: f64,
+) -> Option<Shape> {
+    let parts: Vec<_> = assembly.parts.into_iter().collect();
+    let span = |list: &[ttf_parser::math::GlyphPart]| {
+        list.iter().map(|p| p.full_advance as f64).sum::<f64>()
+            - min_overlap * list.len().saturating_sub(1) as f64
+    };
+    let mut list = Vec::new();
+    for repeat in 0..64 {
+        list = parts
+            .iter()
+            .flat_map(|p| std::iter::repeat_n(*p, if p.part_flags.extender() { repeat } else { 1 }))
+            .collect();
+        if span(&list) >= length || !parts.iter().any(|p| p.part_flags.extender()) {
+            break;
+        }
+    }
+    if list.is_empty() {
+        return None;
+    }
+    let joins = list.len().saturating_sub(1) as f64;
+    let max_overlap = list
+        .windows(2)
+        .map(|w| w[0].end_connector_length.min(w[1].start_connector_length) as f64)
+        .fold(f64::INFINITY, f64::min);
+    let overlap = if joins > 0.0 {
+        (min_overlap + (span(&list) - length).max(0.0) / joins).min(max_overlap.max(min_overlap))
+    } else {
+        0.0
+    };
+    let mut shape = Shape::new();
+    let mut at = 0.0;
+    for part in &list {
+        let (dx, dy) = if vertical { (0.0, at) } else { (at, 0.0) };
+        shape.add(face, part.glyph_id, dx, dy);
+        at += part.full_advance as f64 - overlap;
+    }
+    Some(shape)
+}
