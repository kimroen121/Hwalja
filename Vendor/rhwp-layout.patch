+pub(crate) fn integral_glyph(symbol: &str) -> Option<super::stix::Shape> {
+    let name = match symbol {
+        "∫" => "uni222B",
+        "∬" => "uni222C",
+        "∭" => "uni222D",
+        "∮" => "uni222E",
+        "∯" => "uni222F",
